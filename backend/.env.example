# ReguLens Backend Configuration
# Srujana Tech Fest 2026

# Supabase (PostgreSQL Cloud Database)
# Leave blank to run in offline local mode (guarantees zero demo crashes)
SUPABASE_URL=
SUPABASE_KEY=
# Google Gemini API (for semantic extraction and on-the-fly translation)
GEMINI_API_KEY=

# Offline Resilience (true = use pre-cached verified datasets; false = connect to cloud)
DEMO_OFFLINE_MODE=true
